    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\nconst since = new Date(now.getTime() - 24 * 60 * 60 * 1000);\n\nconst noticias = items\n  .filter(item => {\n    const fecha = item.json.pubDate || item.json.isoDate;\n    if (!fecha) return true;\n    return new Date(fecha) >= since;\n  })\n  .map(item => ({\n    titulo: item.json.title || '',\n    descripcion: (item.json.contentSnippet || item.json.summary || '').slice(0, 300),\n    link: item.json.link || '',\n    fecha: item.json.pubDate || item.json.isoDate || ''\n  }))\n  .slice(0, 30);\n\nconst fecha = now.toLocaleDateString('es-CL', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'America/Santiago' });\n\nconst textoNoticias = noticias.map((n, i) =>\n  `${i+1}. ${n.titulo}\\nFecha: ${n.fecha}\\nResumen: ${n.descripcion}\\nURL: ${n.link}`\n).join('\\n\\n');\n\nreturn [{ json: { noticias, textoNoticias, total: noticias.length, fecha } }];"
      },
