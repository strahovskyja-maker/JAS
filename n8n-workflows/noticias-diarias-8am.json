        1168,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "const parts = $input.first().json.candidates[0].content.parts;\nconst textPart = parts.filter(p => !p.thought).pop() || parts[parts.length - 1];\nlet html = (textPart.text || '').trim();\nhtml = html.replace(/^```html\\s*/i, '').replace(/^```\\s*/i, '').replace(/\\s*```$/i, '').trim();\nreturn [{ json: { html } }];"
      },
