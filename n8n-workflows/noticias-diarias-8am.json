        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": {{ JSON.stringify(\"Eres JAS, asistente de noticias de Juan Andrés, ejecutivo chileno. Sus intereses: ECONOMÍA (Chile y mundo), INTELIGENCIA ARTIFICIAL y DATA CENTERS.\\n\\nAnaliza estas \" + $json.total + \" noticias de las últimas 24 horas. Selecciona las 8 a 12 más relevantes e importantes para él. Luego genera directamente un email HTML elegante y listo para enviar.\\n\\nNOTICIAS:\\n\" + $json.textoNoticias + \"\\n\\nEl email HTML debe tener:\\n- Encabezado: 'Noticias del día — \" + $json.fecha + \"'\\n- Noticias agrupadas por categoría con emoji (💹 Economía Chile, 🌎 Economía Mundo, 🤖 Inteligencia Artificial, 🏢 Data Centers)\\n- Cada noticia: título en negrita con hipervínculo, 2-3 oraciones de resumen\\n- Footer: 'Curado por Gemini · Enviado por JAS'\\n- Fondo blanco, tipografía limpia\\n\\nIMPORTANTE: Responde SOLO con el HTML puro. Sin markdown, sin backticks, sin explicaciones.\") }}\n    }]\n  }],\n  \"generationConfig\": {\"temperature\": 0.7, \"maxOutputTokens\": 8192}\n}",
        "options": {}
      },
      "id": "node-gemini",
      "name": "Gemini — Curar y Redactar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
